# Copia este fichero a .env y rellena los valores. .env NO se versiona.

# Clave secreta de Django. Genera una url-safe (sin símbolos que Docker Compose
# interprete) con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=VAz2KhvsnIaHtGXNarGDJrvrGSNvo0EwpQFnpVhWvBmTWO3oAAN95wasphLbSn4ko7EkeoijBFNplDtyBncrDg

# Modo debug (solo local). Por defecto False.
DJANGO_DEBUG=True

# Hosts permitidos, separados por comas (necesario cuando DEBUG=False).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — estos valores los consumen Django y el contenedor de la BD.
POSTGRES_DB=agro
POSTGRES_USER=agro
POSTGRES_PASSWORD=
# En local (Django en el host) la BD escucha en localhost; en Docker será "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
